APP_NAME=LuxeStay
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
FRONTEND_URL=http://localhost:3000

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=luxestay
DB_USERNAME=root
DB_PASSWORD=

# Set APP_DEBUG=false and use a strong, unique APP_KEY in production.
# Generate APP_KEY with: php artisan key:generate

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=sendmail
MAIL_HOST=127.0.0.1
MAIL_PORT=587

SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1
SESSION_DOMAIN=localhost
SESSION_SECURE_COOKIE=false

# Comma-separated browser origins allowed by the API.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Local uploads are suitable for development. Use S3-compatible object storage in production.
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Optional Stripe test-mode values; keep real secrets out of this file.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
