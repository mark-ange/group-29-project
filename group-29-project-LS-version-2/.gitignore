# Frontend dependencies and build output
frontend/node_modules/
frontend/dist/
frontend/build/

# Backend dependencies
backend/vendor/

# Environment files (ignore all .env* except .env.example)
.env*
!frontend/.env.example
!backend/.env.example

# Local SQLite databases
*.db

# General
coverage/
.DS_Store
*.log

# Laravel storage cache (temporary runtime files)
backend/storage/framework/cache/data/*
!backend/storage/framework/cache/data/.gitignore
