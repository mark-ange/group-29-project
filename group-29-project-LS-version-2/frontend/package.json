{
  "name": "luxestay-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "build:legacy": "node node_modules/vite/bin/vite.js build",
    "start": "next start --hostname 0.0.0.0",
    "clean": "node -e \"if(require('fs').existsSync('dist')){require('fs').rmSync('dist',{recursive:true,force:true})}\"",
    "lint": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:seed": "tsx prisma/seed.ts",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@prisma/client": "^6.19.3",
    "@tailwindcss/vite": "^4.1.14",
    "@types/bcryptjs": "^2.4.6",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "gsap": "^3.15.0",
    "http-proxy-middleware": "^4.2.0",
    "lenis": "^1.3.27",
    "lucide-react": "^0.546.0",
    "lucide-vue-next": "^1.0.0",
    "motion": "^12.23.24",
    "next": "^15.5.28",
    "next-auth": "^5.0.0-beta.32",
    "pinia": "^4.0.3",
    "prisma": "^6.19.3",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sharp": "^0.35.5",
    "three": "^0.186.0",
    "vite": "^6.2.3",
    "vue": "^3.5.42",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.15",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^3.2.4"
  }
}
